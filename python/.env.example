# Application Settings
APP_NAME=MyApp
ENVIRONMENT=DEVELOPMENT
DEBUG=true
VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Settings
DATABASE_URL=postgresql://localhost:5432/myapp
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30.0
DB_SSL_ENABLED=true

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security Settings
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
FEATURE_FLAGS=new_ui=false,beta_features=false

# External Services
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# API Keys
STRIPE_API_KEY=
SENDGRID_API_KEY=

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=false
